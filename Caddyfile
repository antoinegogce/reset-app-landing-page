# RESET App Landing Page
# Redirect root domain to www
getresetapp.com {
    redir https://www.getresetapp.com{uri} permanent
}

# Main site
www.getresetapp.com {
    reverse_proxy app:3000
}

# RESET API (backend self-host)
api.getresetapp.com {
    reverse_proxy reset-api:3001
}

